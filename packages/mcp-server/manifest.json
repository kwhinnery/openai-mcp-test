{
  "dxt_version": "0.2",
  "name": "openai-mcp-test-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the OpenAI API",
  "author": {
    "name": "OpenAI",
    "email": "support@openai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/openai-mcp-test-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/openai-mcp-test-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://platform.openai.com/docs",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "OPENAI_API_KEY": "${user_config.OPENAI_API_KEY}",
        "OPENAI_ORG_ID": "${user_config.OPENAI_ORG_ID}",
        "OPENAI_PROJECT_ID": "${user_config.OPENAI_PROJECT_ID}",
        "OPENAI_WEBHOOK_SECRET": "${user_config.OPENAI_WEBHOOK_SECRET}"
      }
    }
  },
  "user_config": {
    "OPENAI_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    },
    "OPENAI_ORG_ID": {
      "title": "organization",
      "description": "",
      "required": false,
      "type": "string"
    },
    "OPENAI_PROJECT_ID": {
      "title": "project",
      "description": "",
      "required": false,
      "type": "string"
    },
    "OPENAI_WEBHOOK_SECRET": {
      "title": "webhook_secret",
      "description": "",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
